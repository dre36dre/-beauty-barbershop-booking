{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then env -u PYTHONPATH uv run --no-project --python 3.12 --with-requirements requirements.txt -- python backend/manage.py migrate; fi && npm run build",
  "outputDirectory": "dist/beauty-barbershop-booking/browser",
  "rewrites": [
    { "source": "/teste", "destination": "/api/teste" },
    { "source": "/teste/", "destination": "/api/teste" },
    { "source": "/django-admin", "destination": "/api/django-admin" },
    { "source": "/django-admin/", "destination": "/api/django-admin" },
    { "source": "/django-admin/login/", "destination": "/api/django-admin-login" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
