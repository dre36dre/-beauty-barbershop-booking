{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then node scripts/migrate-db.mjs; fi && npm run build",
  "outputDirectory": "dist/beauty-barbershop-booking/browser",
  "rewrites": [
    { "source": "/teste", "destination": "/api/teste" },
    { "source": "/teste/", "destination": "/api/teste" },
    { "source": "/django-admin", "destination": "/api/django-admin" },
    { "source": "/django-admin/", "destination": "/api/django-admin" },
    { "source": "/django-admin/login/", "destination": "/api/django-admin-login" },
    { "source": "/django-admin/logout/", "destination": "/api/django-admin-logout" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
