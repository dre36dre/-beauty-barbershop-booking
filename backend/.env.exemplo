DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Use DATABASE_URL fornecida pelo provedor PostgreSQL na nuvem, ou configure as variáveis abaixo localmente.
DATABASE_URL=
POSTGRES_DB=barbearia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGSSLMODE=disable
DB_CONN_MAX_AGE=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para SMTP real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=...
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=...
