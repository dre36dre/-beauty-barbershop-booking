DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL tem prioridade e deve ser usada para o PostgreSQL remoto na Vercel.
DATABASE_URL=
DB_ENGINE=postgresql
# MySQL local (mysqlclient instalado no Windows)
MYSQL_DATABASE=barbearia_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
# PostgreSQL local ou remoto sem DATABASE_URL
POSTGRES_DB=barbearia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGSSLMODE=disable
DB_CONN_MAX_AGE=0
# SQLite local opcional: defina DB_ENGINE=sqlite.
SQLITE_NAME=db.sqlite3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para SMTP real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=...
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=...
